# 复制为 .env 后按需修改（.env 不要提交到仓库）
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
REDIS_PORT=6379

# 以下仅在启用对应 profile 时生效
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USER=mall
RABBITMQ_PASS=mall
MONGO_PORT=27017
ES_PORT=9200
MINIO_PORT=19000
MINIO_UI_PORT=19001
MINIO_USER=minioadmin
MINIO_PASS=minioadmin

# 监控栈（--profile monitoring）
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASS=admin
# mall-admin 所在机器的 IP（Prometheus 容器要通过它抓 /actuator/prometheus）
# 应用跑在 Docker 宿主机本机 → 留空（默认 host-gateway）
# 应用跑在另一台机器（如 Windows 宿主机）→ 填那台机器的 IP，例如 192.168.150.1
MALL_HOST_IP=
