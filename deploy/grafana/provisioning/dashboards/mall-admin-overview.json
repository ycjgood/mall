{
  "title": "mall-admin 应用概览",
  "uid": "mall-admin-overview",
  "tags": ["mall", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "接口 QPS（按 URI Top 10）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{application=\"mall-admin\", uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "响应耗时 P95 / P99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"mall-admin\"}[5m])))",
          "legendFormat": "P95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"mall-admin\"}[5m])))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "type": "stat",
      "title": "错误率（5xx 占比）",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"mall-admin\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"mall-admin\"}[5m])), 0.0001)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "JVM 堆内存使用率",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(jvm_memory_used_bytes{application=\"mall-admin\", area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{application=\"mall-admin\", area=\"heap\"}), 1)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tomcat 线程池（busy / current）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "tomcat_threads_busy_threads{application=\"mall-admin\"}", "legendFormat": "busy" },
        { "refId": "B", "expr": "tomcat_threads_current_threads{application=\"mall-admin\"}", "legendFormat": "current" },
        { "refId": "C", "expr": "tomcat_threads_config_max_threads{application=\"mall-admin\"}", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries",
      "title": "数据库连接池（HikariCP）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active{application=\"mall-admin\"}", "legendFormat": "active" },
        { "refId": "B", "expr": "hikaricp_connections_idle{application=\"mall-admin\"}", "legendFormat": "idle" },
        { "refId": "C", "expr": "hikaricp_connections_pending{application=\"mall-admin\"}", "legendFormat": "pending" }
      ]
    }
  ]
}
